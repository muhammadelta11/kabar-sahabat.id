APP_NAME="Kabar Sahabat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kabarsahabat.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kabarsahabat
DB_USERNAME=kabarsahabat
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# butuh supervisor queue:work (lihat deploy/supervisor-kabarsahabat.conf)
QUEUE_CONNECTION=database

# file lebih ringan dari database di shared hosting; ganti redis jika tersedia
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kabarsahabat.id"
MAIL_FROM_NAME="${APP_NAME}"

# CDN gambar: set MEDIA_DISK=s3 setelah sync (php artisan media:sync-to-cloud)
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=https://cdn.kabarsahabat.id
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT=

VITE_APP_NAME="${APP_NAME}"
